# Backend
OPENWEATHER_API_KEY=your_openweather_api_key
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
OPENWEATHER_TIMEOUT_SECONDS=12
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=30
MIN_OBSERVED_DAYS=30
AQI_HISTORY_DAYS=365
AQI_HISTORY_BATCH_DAYS=30
GEOCODE_CACHE_TTL_SECONDS=21600
HISTORY_CACHE_TTL_SECONDS=1800
PREDICTION_CACHE_TTL_SECONDS=900
METRO_CACHE_TTL_SECONDS=300

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
